<Page x:Class="GertecServer.Views.Terminal"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GertecServer.Views"
      xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="1009" d:DesignWidth="1870"
      Title="Terminal">
    <Grid Background="#FFF1F1F1">
        <StackPanel Margin="20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" >
                <md:Card Margin="30" Height="300" Width="700" UniformCornerRadius="20" md:ElevationAssist.Elevation="Dp8">
                    <Grid Margin="10">
                        <StackPanel Orientation="Horizontal">
                            <Image Height="250" Width="200" />
                            <Rectangle Width="1" Height="250" Fill="Gray"/>
                            <StackPanel Margin="10,0,0,0">
                                <TextBlock Text="Terminal 1" FontSize="30" VerticalAlignment="Center" Margin="20,20,20,5" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal">
                                    <md:PackIcon Kind="Circle" Width="15" Height="15" Margin="20,12,0,5" Foreground="Green"/>
                                    <TextBlock Text="Status: Online" FontSize="20" VerticalAlignment="Center" Margin="15,5,20,5" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="Modelo: " FontSize="20" Margin="20,20,0,5"/>
                                <TextBlock Text="IP: " FontSize="20" Margin="20,0,0,5"/>
                                <TextBlock Text="Tempo de Exibição: " FontSize="20" Margin="20,0,0,5"/>
                                <TextBlock Text="Texto 1: " FontSize="20" Margin="20,0,0,5"/>
                                <TextBlock Text="Texto 2: " FontSize="20" Margin="20,0,0,5"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </md:Card>
                <md:Card Margin="30" UniformCornerRadius="20" md:ElevationAssist.Elevation="Dp8" Width="350">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="Rede" FontSize="30" FontWeight="SemiBold" Margin="20"/>
                            <md:PackIcon Kind="Network" HorizontalAlignment="Right" VerticalAlignment="Center" Width="40" Height="40" Margin="0,0,25,0"/>
                        </Grid>
                        <Separator Margin="15,0,15,0" Foreground="Gray" Height="1"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                            <RadioButton Content="DHCP" Style="{DynamicResource MaterialDesignTabRadioButton}"
                                         BorderBrush="Blue" IsChecked="True" FontSize="20" Margin="20,0,20,0"/>
                            <RadioButton Content="IP Fixo" Style="{DynamicResource MaterialDesignTabRadioButton}"
                                         BorderBrush="Blue" IsChecked="False" FontSize="20" Margin="20,0,20,0"/>
                        </StackPanel>
                        <TextBlock Text="IP Terminal: 192.168.0.18" FontSize="20" Margin="20,10,0,0"/>
                        <TextBlock Text="IP Servidor: 192.168.0.20" FontSize="20" Margin="20,0,0,0"/>
                        <TextBlock Text="Máscara de Rede: 255.255.255.0" FontSize="20" Margin="20,0,0,0"/>
                        <TextBlock Text="Gateway: 192.168.0.1" FontSize="20" Margin="20,0,0,0"/>
                        <TextBlock Text="Servidor DNS: 192.168.0.1" FontSize="20" Margin="20,0,0,0"/>
                        
                    </StackPanel>
                </md:Card>
            </StackPanel>
            
        </StackPanel>
    </Grid>
</Page>
